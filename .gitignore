# ==============================================================================
# Git Ignore Configuration for FloodGuard (SERENITY)
# ==============================================================================

# 1. Environment Secrets & Passwords (NEVER COMMIT)
.env
.env.local
.env.*.local
*.pem
*.key

# 2. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# 3. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 4. OS Specific Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# 5. Node.js & Frontend Artifacts (for Next.js)
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. Raw Heavy Satellite Rasters & Intermediate Extraction (Keep Processed GeoJSONs)
data/raw/spatial/*.tif
data/raw/spatial/*.tiff
data/raw/imd/*.nc
data/processed/spatial/real_gee_spatiotemporal_dataset.csv
data/processed/spatial/spatial_event_dataset.csv

# 7. IDE & Editor Metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
